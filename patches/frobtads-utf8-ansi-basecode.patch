+static size_t utf8_fwd_len_sb(osgen_txtwin_t *win, char *p)
+{
+    unsigned char c;
+    size_t need, i;
+    char *q;
+
+    c = (unsigned char)*p;
+
+    if (!oss_utf8_mode() || c < 0x80)
+        return 1;
+
+    if ((c & 0xE0) == 0xC0)
+        need = 2;
+    else if ((c & 0xF0) == 0xE0)
+        need = 3;
+    else if ((c & 0xF8) == 0xF0)
